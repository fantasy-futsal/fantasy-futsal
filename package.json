{
	"name": "fantasy-futsal",
	"version": "0.0.1",
	"description": "Fantasy Futsal monorepo",
	"private": true,
	"scripts": {
		"dev": "pnpm --filter @fantasy-futsal/frontend dev",
		"build": "pnpm -r --parallel build",
		"lint": "pnpm -r --parallel lint && uv run ruff check .",
		"format": "pnpm -r --parallel format && prettier --write \"*.{js,ts,json,md,yml,yaml}\"",
		"check": "pnpm -r --parallel check && uv run mypy .",
		"test": "pnpm -r --parallel test"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.1.3",
			"onFail": "download"
		}
	},
	"type": "module",
	"devDependencies": {
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.9.1",
		"eslint": "^10.4.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4"
	}
}
